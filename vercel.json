{
  "functions": {
    "api/proxy.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/proxy",
      "headers": [
        {"key":"Access-Control-Allow-Origin","value":"*"},
        {"key":"Access-Control-Allow-Methods","value":"GET,HEAD,OPTIONS"},
        {"key":"Access-Control-Allow-Headers","value":"*"}
      ]
    }
  ]
}